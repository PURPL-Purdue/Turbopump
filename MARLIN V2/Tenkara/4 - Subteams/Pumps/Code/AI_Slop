g = Q_(9.81, 'm/s^2')

@dataclass
class InputGeometry:
	Z_blade: int			# number of impeller blades
	Beta2B: Q_[float]		# blade backsweep angle at outlet (from tangent)
	d_1: Q_[float]			# impeller inlet diameter
	d_2: Q_[float]			# impeller outlet diameter
	b_2: Q_[float]			# impeller outlet height
	thk2: Q_[float]			# blade thickness at exit
	d_hub: Q_[float]		# diameter of hub, strictly speaking inlet only

@dataclass
class DesignPoint:
	Q: Q_[float]			# volumetric flowrate
	N_shaft: Q_[float]		# shaft rotating speed
	H: Q_[float]			# headrise, developed head
	n_hyd_BEP: float		# hydraulic efficiency at BEP

# Wiesner slip factor: https://manual.cfturbo.com/en/bl_te_wiesner.html
def GetWiesnerSlipRatio(beta2b: Q_[float], Z: int) -> Q_[float]:
	return 1 - np.sqrt(np.sin(beta2b)) / Z**0.7

def GetBladeBlockage(beta2b: Q_[float], Z: int, thick: Q_[float], b2: Q_[float]) -> Q_[float]:
	return thick * b2 * Z / np.sin(beta2b)

def ArclenContour(flat: float, R: float, d_i: float, d_o: float):

	total_arclen = flat + R * np.pi/2 + (d_o - d_i)/2 - R

	def Func(s: float) -> tuple[float, float]:
		s_true = s * total_arclen

		if s_true <= flat:
			return (s_true, d_i/2)
		elif s_true < (flat + R * np.pi/2):

			theta = (s_true - flat) / R - np.pi/2
			
			x = flat + R * np.cos(theta)
			y = d_i/2 + R * (1 + np.sin(theta))
			return (x, y)
		
		wall_len = s_true - (flat + R * np.pi/2)
		return (flat + R, d_i/2 + R + wall_len)

	# normalized arclength where the flat ends and where the arc ends (wall begins),
	# so CAD code can rebuild line / arc / line exactly instead of splining samples
	_len = lambda v: v.to('m').magnitude if hasattr(v, 'to') else float(v)
	Func.knots = (_len(flat) / _len(total_arclen),
				  _len(flat + R * np.pi/2) / _len(total_arclen))

	return Func


def _bez(P, t):
	t = np.asarray(t, float)[:, None]
	return ((1 - t) ** 3) * P[0] + 3 * ((1 - t) ** 2) * t * P[1] \
		+ 3 * (1 - t) * t ** 2 * P[2] + t ** 3 * P[3]


def _dbez(P, t):
	t = np.asarray(t, float)[:, None]
	return 3 * ((1 - t) ** 2 * (P[1] - P[0]) + 2 * (1 - t) * t * (P[2] - P[1])
				+ t ** 2 * (P[3] - P[2]))


@dataclass
class CadParams:
	"""Knobs for CAD generation only, none of these feed back into the 1D analysis.
	Lengths are pint quantities; the CAD model itself is built in millimetres."""
	n_span: int = 5								# spanwise sections lofted into the blade (>= 3)
	n_pts: int = 60								# points along each blade line (LE to TE)
	incidence: Q_ = field(default_factory=lambda: Q_(2, 'deg'))		# blade angle minus flow angle at LE
	beta_le_min: Q_ = field(default_factory=lambda: Q_(10, 'deg'))	# floor on LE blade angle (keeps wrap angle sane)
	beta_handles: tuple = (1/3, 1/3)			# Bezier handle lengths (LE, TE) as fraction of blade length, sum <= 1
	s_le_hub: float = 0.05						# LE position on hub contour, normalized arclength
	s_le_shroud: float = 0.0					# LE position on shroud contour, normalized arclength
	t_le: Q_ = None								# blade thickness at LE, default 0.5 * thk2 (linear taper to thk2 at TE)
	stack: str = 'TE'							# 'TE': trailing edge is a straight axial line, 'LE': leading edge is
	rotation_sign: int = 1						# +1: shaft turns toward +theta (right hand rule about +Z)
	tip_clearance: Q_ = field(default_factory=lambda: Q_(0.25, 'mm'))	# blade tip to shroud contour, axial/radial gap
	root_overlap: Q_ = field(default_factory=lambda: Q_(0.5, 'mm'))	# blade root buried into hub so the union is clean
	t_back: Q_ = field(default_factory=lambda: Q_(3, 'mm'))			# hub disk thickness behind the flow surface
	bore_diam: Q_ = None						# shaft bore, None for a solid hub


def _ContourTable(contour, n: int = 1000):
	"""Dense table of a meridional contour in mm. Returns f(s) -> (len(s), 2) array of (axial, radial),
	with the raw table on f.table. Contours here are scalar functions of normalized arclength,
	so tabulating once keeps the blade code vectorized."""
	s_tab = np.linspace(0, 1, n)
	pts = np.array([[c.to('mm').magnitude for c in contour(s)] for s in s_tab])

	def f(s):
		s = np.asarray(s, float)
		return np.column_stack([np.interp(s, s_tab, pts[:, 0]), np.interp(s, s_tab, pts[:, 1])])

	f.table = pts
	return f


class Impeller:

	def __init__(self, geometry: InputGeometry, design_point: DesignPoint):

		assert geometry.d_1 > geometry.d_hub, 'Inlet diameter must be larger than hub diameter'
		
		self.DP: DesignPoint = design_point

		self.SpecificSpeed: float = (	# imperial specific speed
					self.DP.N_shaft.to('rpm') * np.sqrt(self.DP.Q.to('gallon/min')) /
					self.DP.H.to('ft')**0.75
					).magnitude
		
		self.n_q: float = (		# metric specific speed
			self.DP.N_shaft.to('rpm') * np.sqrt(self.DP.Q.to('m^3/s')) /
			self.DP.H.to('m')**0.75
			).magnitude
		
		exit_area: Q_[float] = (np.pi * geometry.d_2 * geometry.b_2 - GetBladeBlockage(
			geometry.Beta2B, geometry.Z_blade, geometry.thk2, geometry.b_2
		))

		self.Z_blade = geometry.Z_blade
		self.Beta2B = geometry.Beta2B
		self.d_1 = geometry.d_1
		self.d_2 = geometry.d_2
		self.b_2 = geometry.b_2
		self.thk2 = geometry.thk2
		self.d_hub = geometry.d_hub
		self.WiesnerSlip = GetWiesnerSlipRatio(geometry.Beta2B, geometry.Z_blade)
		self.Area2 = exit_area
		self.Z_e: Q_[float] = ((self.d_2 - self.d_1)*((self.n_q/74)**(1.07)))	# axial extension, Gulich, pg. 348

		self.HubContour = ArclenContour(0, self.Z_e + self.b_2, self.d_hub, self.d_2)

		# exit tip velocity at design point
		self.U_2_design = (self.DP.N_shaft * self.d_2/2).to('m/s')
		# meridional exit flow velocity at design point
		self.C_m2_design = (self.DP.Q / self.Area2).to('m/s')

		_, enthalpy, _ = self.GetSpecificWork()
		# AKA Stage loading: Δh / u^2 = g*H / u^2
		self.HeadCoeff: float = (enthalpy/self.U_2_design**2).to('dimensionless').magnitude
		# AKA Flow factor: c / u
		self.FlowCoeff: float = (self.C_m2_design / self.U_2_design).to('dimensionless').magnitude

	@property
	def Area1(self) -> Q_[float]:
		return np.pi / 4 * (self.d_1**2 - self.d_hub**2) # TODO: blade blockage?
	@property
	def NPSH_i(self) -> Q_[float]:
		"""
			This method of calculating NPSH_i accounts for inlet velocity and losses.
			Therefore, when comparing with available NSPH, total pressure should be used for NPSH_a calculation
			NPSH_i = (lambda_c * 1/2 * c_m^2 + lambda_w * 1/2 * w^2) / g

			The physical intuition for the NPSH coefficients is that if the coefficients were equal to 1,
			then the drop in static pressure due to suction is merely the dynamic pressure due to
			acceleration of the flow at the inlet due to inlet area reduction (c_m, merdional velocity)
			and the acceleration of the flow over and around the blade leading edge (w, relative velocity)

		"""

		# Gulich, Centrifugal Pumps, chap. 6
		lambda_c = 1.2	# NPSH coefficient for main flow acceleration and losses at inlet
		lambda_w = 1.0	# NPSH coefficient for excess velocity due to flow around leading edge
		
		c_1m = self.DP.Q / self.Area1	# meridional velocity at inlet
		w_1 = np.sqrt(					# relative velocity of flow at leading edge
			(self.DP.N_shaft * self.d_1/2)**2 + c_1m**2
			)
		return (1/2 / g * (lambda_c * c_1m**2 + lambda_w * w_1**2)).to('m')
	
	def H_euler(self, Q):
		"""
		https://ntrs.nasa.gov/api/citations/19950013379/downloads/19950013379.pdf
		page 4 and 5
		
		Theoretical Euler head as a function of Q
		H_theoretical(Q) = U_2^2/g - [U_2 / (g*Area2*tan(beta2b))] * Q
		Or
		H_theoretical(Q) = U_2^2/g - [N_shaft*cot(beta2b)/(2*pi*b2*g)] * Q
		https://youtu.be/H7XfYO_-cEg?t=2705
		"""
		sigma = self.WiesnerSlip
		U_2_design = self.U_2_design
		N = self.DP.N_shaft
		beta2b = self.Beta2B
		b2 = self.b_2

		return sigma * U_2_design**2/g - N/np.tan(beta2b)/(2*np.pi*b2*g) * Q

	def SweepInletDiam(self) -> go.Figure:

		npsh = []
		diam = []
		min_NPSH = Q_(np.inf, 'm')
		opt_diam = Q_(-1, 'in')

		old_d_1 = self.d_1

		for d_1 in np.linspace(self.d_hub, self.d_2, 100):
			self.d_1 = d_1
			NPSH_i = self.NPSH_i
			
			if NPSH_i < min_NPSH:
				min_NPSH = NPSH_i.to('m')
				opt_diam = d_1.to('in')
			
			npsh.append(NPSH_i.magnitude)
			diam.append(d_1.to('in').magnitude)
			
		self.d_1 = old_d_1

		fig = go.Figure()
		fig.add_trace(go.Scatter(
			x=diam, y=npsh,
			mode='lines', name='NPSH_i'
		))
		fig.add_trace(go.Scatter(
			x=[opt_diam.magnitude], y=[min_NPSH.magnitude],
			mode='markers',
			name=f'Optimal: {opt_diam:.2f}, {min_NPSH:.0f}',
			marker=dict(size=9, symbol='circle')
		))
		fig.update_layout(
			title='NPSH inception vs inlet diameter',
			xaxis_title='Inlet diameter (in.)',
			yaxis_title='NPSH_i (m)',
			template='plotly_white'
		)
		fig.update_xaxes(showgrid=True)
		fig.update_yaxes(showgrid=True)
		fig.show()

		return fig

	def GetInletVelocities(self, flow_Q: Q_[float]=None, speed_N: Q_[float]=None) -> VelocityTriangle:
		# no preswirl
		flow_Q = flow_Q if not flow_Q is None else self.DP.Q
		speed_N = speed_N if not speed_N is None else self.DP.N_shaft

		c_m1 = flow_Q / self.Area1
		c_u1 = Q_(0, 'm/s')
		u_1 = speed_N * self.d_1/2
		w_u1 = u_1 - c_u1
		#c = np.sqrt(c_m1**2 + c_u1**2)
		w = np.sqrt(w_u1**2 + c_m1**2)

		return VelocityTriangle(
			u=u_1, c_m=c_m1, c_u=c_u1, w=w
		)

	def GetOutletVelocities(self, flow_Q: Q_[float]=None, speed_N: Q_[float]=None) -> tuple[VelocityTriangle, float]:
		flow_Q = flow_Q if not flow_Q is None else self.DP.Q
		speed_N = speed_N if not speed_N is None else self.DP.N_shaft
		
		f = emp.FlowSpeedRatio(
				flow_Q, speed_N,
				self.DP.Q, self.DP.N_shaft
				).to('dimensionless').magnitude
		
		U_2 = speed_N * self.d_2/2
		C_m2 = flow_Q / self.Area2
		slip = U_2 * (1 - self.WiesnerSlip)
		W_u2 = C_m2 / np.tan(self.Beta2B) + slip
		W_2 = np.sqrt(C_m2**2 + W_u2**2)
		C_u2 = (U_2 - W_u2)
		
		return VelocityTriangle(
			u=U_2, c_m=C_m2, c_u=C_u2, w=W_2
		), f

	def GetSpecificWork(self, speed_N: Q_[float]=None, flow_Q: Q_[float]=None) -> tuple[Q_[float], Q_[float], float]:
		"""
			Returns
			1. Brake work, work consumed by the impeller per unit mass of fluid
			2. Fluid work, work done on the fluid per unit mass of fluid
			3. flowspeed factor, non-dimensional number, low confidence of analysis if greater than 2
		"""
		if speed_N is None:
			speed_N = self.DP.N_shaft
		if flow_Q is None:
			flow_Q = self.DP.Q

		#vels: VelocityTriangle
		#f: float
		vels, f = self.GetOutletVelocities(flow_Q, speed_N)
		# Euler turbomachinery equation
		brake_work = (vels.c_u * vels.u).to('kJ/kg')

		# empirical prediction, valid for 0 < f < 2
		n_hydraulic = emp.HydraulicEfficiency(f) * self.DP.n_hyd_BEP

		fluid_work = brake_work * n_hydraulic

		return (brake_work, fluid_work, f)
		
	def PlotPerformanceHQ(self, rpm_sweep: Q_[list[float]]=None) -> go.Figure:
		N_sweep = rpm_sweep if rpm_sweep is not None else Q_([self.DP.N_shaft])
		Q_sweep = Q_(np.linspace(0, 2.0 * self.DP.Q.to('L/s').magnitude, 50), 'L/s')

		H_predict = []
		Q_predict = []

		for speed_N in N_sweep:

			head_trace = []
			flow_trace = []

			for flow_Q in Q_sweep:
				
				_, fluid_work, f = self.GetSpecificWork(speed_N=speed_N, flow_Q=flow_Q)
				if f > 2: continue

				headrise = fluid_work / g
		
				head_trace.append(headrise.to('m').magnitude)
				flow_trace.append(flow_Q.to('L/s').magnitude)
		
			H_predict.append(head_trace)
			Q_predict.append(flow_trace)

		fig = go.Figure()
		# Plot theoretical Euler (linear)
		H_theoretical = self.H_euler(Q_sweep)
		fig.add_trace(go.Scatter(
			x=Q_sweep.to('L/s').magnitude,
			y=H_theoretical.to('m').magnitude,
			mode='lines', name='Theoretical Euler',
			line=dict(color='gray', dash='dash')
		))

		# Plot RPM swept traces
		for i in range(len(H_predict)):
			fig.add_trace(go.Scatter(
				x=Q_predict[i], y=H_predict[i],
				mode='lines',
				name='Empirical prediction' if i == 0 else f'Empirical prediction ({N_sweep[i].magnitude:.0f} RPM)',
				line=dict(color='red'),
				showlegend=(i == 0)
			))
			if Q_predict[i] and H_predict[i]:
				fig.add_annotation(
					x=Q_predict[i][-1], y=H_predict[i][-1],
					text=f"{N_sweep[i].magnitude:.0f} RPM",
					showarrow=False, xshift=25, yshift=0,
					font=dict(size=10)
				)

		# Plot design point head and flowrate
		fig.add_trace(go.Scatter(
			x=[self.DP.Q.to('L/s').magnitude],
			y=[self.DP.H.to('m').magnitude],
			mode='markers', name='Design point',
			marker=dict(color='black', size=7)
		))

		fig.update_layout(
			title='H-Q Curve',
			xaxis_title='Volumetric flow rate [L/s]',
			yaxis_title='Head [m]',
			yaxis=dict(rangemode='tozero'),
			legend=dict(x=1, y=1, xanchor='right', yanchor='top'),
			template='plotly_white'
		)
		fig.update_xaxes(showgrid=True, gridcolor='rgba(128,128,128,0.3)')
		fig.update_yaxes(showgrid=True, gridcolor='rgba(128,128,128,0.3)')
		fig.show()

		return fig

	def PlotMeridional(self, l: str = 'in', color: str = 'black', R_ratio = 1.3) -> go.Figure:

		fig = go.Figure()
		
		d_1	= self.d_1.to(l)
		Z_e = self.Z_e.to(l)
		b_1 = (self.d_1 - self.d_hub).to(l)
		b_2 = self.b_2.to(l)
		g_1 = (0.3 * b_1/2).to(l)
		R_ds = (Z_e - g_1).to(l) # front shroud radius
		d_2 = self.d_2.to(l)
		d_hub = self.d_hub.to(l)

		R_ts = R_ratio * R_ds

		fig.add_trace(go.Scatter(
			x=[0, 0], y=[d_hub.m/2, d_1.m/2],
			mode='lines', name='Inlet', line=dict(dash='dot', color=color)
		))

		fig.add_trace(go.Scatter(
			x=[Z_e.m, Z_e.m + b_2.m],
			y=[d_2.m/2, d_2.m/2],
			mode='lines', name='Outlet', line=dict(dash='dot', color=color)
		))

		shroud_contour = self.ShroudContour()
		shroud_x, shroud_y = [], []

		hub_x, hub_y = [], []
		mean_x, mean_y = [], []

		for s in np.linspace(0, 1, 100):
			x1, y1 = shroud_contour(s)
			shroud_x.append(x1.m)
			shroud_y.append(y1.m)

			x2, y2 = self.HubContour(s)
			hub_x.append(x2.m)
			hub_y.append(y2.m)

			a = 0.5
			mean_x.append((x1*a + (1 - a) * x2).m)
			mean_y.append((y1*a + (1 - a) * y2).m)

		fig.add_trace(go.Scatter(
			x=shroud_x, y=shroud_y,
			mode='lines', name='Shroud Contour', line=dict(color=color)
		))

		fig.add_trace(go.Scatter(
			x=hub_x, y=hub_y,
			mode='lines', name='Hub Contour', line=dict(color=color)
		))

		fig.add_trace(go.Scatter(
			x=mean_x, y=mean_y,
			mode='lines', name='Meanline Contour', line=dict(color=color, dash='dashdot')
		))

		fig.add_trace(go.Scatter(
			x=[0, Z_e.m + b_2.m], y=[0, 0],
			mode='lines', name='Meridional axis', line=dict(dash='dash', color='grey')
		))

		fig.update_yaxes(
			scaleanchor="x",
			scaleratio=1,
		)

		fig.update_layout(
			title="Impeller Meridional Cross-Section",
			xaxis_title=f"Meridional position ({l})",
			yaxis_title=f"Radial position ({l})",
			template="plotly_white"
		)

		fig.show()

		return fig

	# ------------------------------------------------------------------
	# CAD geometry (CadQuery). Axis of rotation is +Z, the meridional plot's
	# axial coordinate becomes Z (flow goes toward +Z), radial stays radial, and
	# all lengths are millimetres.

	def ShroudContour(self):
		"""Shroud (casing side) meridional contour, same construction PlotMeridional uses."""
		b_1 = self.d_1 - self.d_hub
		g_1 = 0.3 * b_1/2
		R_ds = self.Z_e - g_1
		return ArclenContour(g_1, R_ds, self.d_1, self.d_2)

	def _MeridionalTables(self):
		hub = _ContourTable(self.HubContour)
		shroud = _ContourTable(self.ShroudContour())
		r_2 = self.d_2.to('mm').magnitude / 2
		for name, tab in (('hub', hub), ('shroud', shroud)):
			if abs(tab.table[-1, 1] - r_2) > 1e-3:
				raise ValueError(
					f'{name} contour ends at r = {tab.table[-1, 1]:.3f} mm, not the exit radius {r_2:.3f} mm. '
					'The corner radius is larger than the room available (Z_e + b_2 > (d_2 - d_hub)/2 for the hub); '
					'check Z_e, b_2 and the diameters.')
		return hub, shroud

	def GetBladeLines(self, cad: CadParams = None, phis=None) -> list:
		"""
		Blade camber lines on streamlines that sit a fraction phi of the way from hub (0) to shroud (1).
		Streamline phi is the blend of hub and shroud contour points at equal normalized arclength
		(the same construction as the meanline in PlotMeridional).

		Gulich's procedure: the blade angle beta (from the tangent) is prescribed against meridional
		length m, and the plan view follows from the conformal (m, u = r*theta) plane:
			tan(beta) = dm / (r dtheta)    ->    dtheta = dm / (r tan(beta))
		so theta(m) = theta_0 -/+ integral(dm / (r tan beta)), backswept so theta falls along the flow
		for a shaft turning toward +theta.

		beta(m) is a cubic Bezier from the LE angle (zero incidence flow angle plus incidence, no preswirl)
		to Beta2B, with zero slope at both ends when the handles are equal.

		Returns a list of dicts (lengths in mm, angles in rad) with keys
		phi, s, z, r, m, xi, beta, theta, t, delta, e, hub, shroud
			xi    m / m_total
			t     blade normal thickness
			delta half tangential thickness in theta, t / (2 r sin(beta))
			e     unit vector in (z, r) pointing hub -> shroud
		"""
		cad = cad or CadParams()
		if cad.n_span < 3:
			raise ValueError('n_span must be at least 3')
		phis = np.linspace(0, 1, cad.n_span) if phis is None else np.asarray(phis, float)

		hub, shroud = self._MeridionalTables()

		c_m1 = (self.DP.Q / self.Area1).to('m/s').magnitude
		omega = self.DP.N_shaft.to('rad/s').magnitude
		beta2 = self.Beta2B.to('rad').magnitude
		beta_min = cad.beta_le_min.to('rad').magnitude
		inc = cad.incidence.to('rad').magnitude
		t_te = self.thk2.to('mm').magnitude
		t_le = cad.t_le.to('mm').magnitude if cad.t_le is not None else 0.5 * t_te

		a, b = cad.beta_handles
		if a < 0 or b < 0 or a + b > 1:
			raise ValueError('beta_handles must be non-negative and sum to at most 1 (keeps beta(m) single valued)')
		tt = np.linspace(0, 1, 200)

		lines = []
		for phi in phis:
			s_le = cad.s_le_hub + phi * (cad.s_le_shroud - cad.s_le_hub)
			s = np.linspace(s_le, 1.0, cad.n_pts)
			H, S = hub(s), shroud(s)
			pt = H + phi * (S - H)
			z, r = pt[:, 0], pt[:, 1]

			m = np.concatenate([[0.0], np.cumsum(np.hypot(np.diff(z), np.diff(r)))])
			xi = m / m[-1]

			# LE blade angle from the inlet velocity triangle at this radius
			beta1 = np.arctan2(c_m1, omega * r[0] * 1e-3) + inc
			if beta1 < beta_min:
				warnings.warn(f'phi={phi:.2f}: LE blade angle {np.degrees(beta1):.1f} deg raised to '
							  f'beta_le_min = {np.degrees(beta_min):.1f} deg')
				beta1 = beta_min

			P = np.array([[0.0, beta1], [a, beta1], [1 - b, beta2], [1.0, beta2]])
			assert np.all(_dbez(P, tt)[:, 0] >= -1e-12), 'beta(m) Bezier is not monotonic in m'
			curve = _bez(P, tt)
			beta = np.interp(xi, curve[:, 0], curve[:, 1])

			# plan view: dtheta = dm / (r tan(beta)), trapezoid rule
			f = 1.0 / (r * np.tan(beta))
			wrap = np.concatenate([[0.0], np.cumsum(0.5 * (f[1:] + f[:-1]) * np.diff(m))])
			theta = -cad.rotation_sign * wrap
			if cad.stack.upper() == 'TE':
				theta = theta - theta[-1]

			t = t_le + (t_te - t_le) * xi
			delta = t / (2 * r * np.sin(beta))

			blockage = self.Z_blade * t / (2 * np.pi * r * np.sin(beta))
			if blockage.max() > 0.5:
				warnings.warn(f'phi={phi:.2f}: blade blockage reaches {blockage.max():.2f} '
							  f'(at xi = {xi[blockage.argmax()]:.2f}); consider thinner blades, fewer blades or larger beta')

			span = S - H
			e = span / np.maximum(np.hypot(span[:, 0], span[:, 1]), 1e-9)[:, None]

			lines.append(dict(phi=phi, s=s, z=z, r=r, m=m, xi=xi, beta=beta, theta=theta,
							  t=t, delta=delta, e=e, hub=H, shroud=S))
		return lines

	def _SectionWire(self, ln: dict, shift_mm: float = 0.0) -> cq.Wire:
		"""
		Closed blade section along one streamline: pressure side, blunt TE, suction side, round LE.
		The blade is thickened tangentially by +/- delta (not along the normal), which keeps the section
		on the meridional streamline and gives normal thickness t, matching GetBladeBlockage.
		shift_mm slides the whole section along the hub->shroud direction (root overlap, tip clearance).
		"""
		z = ln['z'] + shift_mm * ln['e'][:, 0]
		r = ln['r'] + shift_mm * ln['e'][:, 1]
		th = ln['theta']

		def pts(theta):
			return [cq.Vector(ri*np.cos(ti), ri*np.sin(ti), zi) for ri, ti, zi in zip(r, theta, z)]

		ps = pts(th + ln['delta'])
		ss = pts(th - ln['delta'])

		# round LE: arc through the two LE offset points and a point pushed upstream along the camber tangent
		c0 = pts(th)
		T = c0[1] - c0[0]
		mid = c0[0] - T * (0.5 * ln['t'][0] / T.Length)

		edges = [
			cq.Edge.makeSpline(ps),
			cq.Edge.makeLine(ps[-1], ss[-1]),
			cq.Edge.makeSpline(ss[::-1]),
			cq.Edge.makeThreePointArc(ss[0], mid, ps[0]),
		]
		return cq.Wire.assembleEdges(edges)

	def BuildBlade(self, cad: CadParams = None) -> cq.Solid:
		"""One blade, loft through the spanwise sections. Root is buried into the hub, tip sits off the shroud."""
		cad = cad or CadParams()
		lines = self.GetBladeLines(cad)
		root = -cad.root_overlap.to('mm').magnitude
		tip = -cad.tip_clearance.to('mm').magnitude
		if cad.root_overlap >= cad.t_back:
			raise ValueError('root_overlap must be smaller than t_back or the root pokes out of the hub disk')

		wires = []
		for i, ln in enumerate(lines):
			shift = root if i == 0 else tip if i == len(lines) - 1 else 0.0
			wires.append(self._SectionWire(ln, shift))

		# cq.Solid.makeLoft asks OCC for a capped solid, which needs planar end wires. These sections are
		# 3D curves, so loft a shell and cap root and tip with n-sided fill surfaces instead.
		loft = BRepOffsetAPI_ThruSections(False, False)
		for w in wires:
			loft.AddWire(w.wrapped)
		loft.Build()
		side = cq.Shape.cast(loft.Shape())
		caps = [cq.Face.makeNSidedSurface(w.Edges(), []) for w in (wires[0], wires[-1])]
		blade = cq.Solid.makeSolid(cq.Shell.makeShell(list(side.Faces()) + caps))
		if not blade.isValid() or blade.Volume() <= 0:
			warnings.warn('Blade is not a valid solid; try fewer spanwise sections or a smoother beta distribution')
		return blade

	def BuildHub(self, cad: CadParams = None) -> cq.Workplane:
		"""Hub disk: flow surface is the meridional hub contour (line, arc, line), revolved about Z."""
		cad = cad or CadParams()
		hub, _ = self._MeridionalTables()
		s_a, s_b = self.HubContour.knots

		def P(s):
			x, y = hub(np.array([s]))[0]
			return float(y), float(x)		# workplane coords: (radius, axial)

		(r0, z0), (ra, za), (rm, zm), (rb, zb), (r1, z1) = (
			P(0.0), P(s_a), P((s_a + s_b) / 2), P(s_b), P(1.0))
		t_back = cad.t_back.to('mm').magnitude
		r_in = cad.bore_diam.to('mm').magnitude / 2 if cad.bore_diam is not None else 0.0
		if r_in >= r0:
			raise ValueError('bore_diam must be smaller than d_hub')

		wp = cq.Workplane('XZ').moveTo(r_in, z0).lineTo(r0, z0)
		if np.hypot(ra - r0, za - z0) > 1e-6:
			wp = wp.lineTo(ra, za)								# axial run before the corner
		wp = wp.threePointArc((rm, zm), (rb, zb))				# corner
		if np.hypot(r1 - rb, z1 - zb) > 1e-6:
			wp = wp.lineTo(r1, z1)								# radial wall out to the exit radius
		wp = wp.lineTo(r1, z1 + t_back).lineTo(r_in, z1 + t_back).close()

		return wp.revolve(360, (0, 0, 0), (0, 1, 0))

	def BuildImpeller(self, cad: CadParams = None, fuse: bool = False) -> cq.Workplane:
		"""
		Open (unshrouded) impeller: hub disk with Z_blade blades.

		fuse=False (default): returns hub + blades as separate overlapping solids in one compound. Always
		works and exports; do the Unite/Boolean in your CAD package (the blade roots are buried in the hub
		on purpose so the union is clean there).
		fuse=True: boolean-unions them in OCC, one blade at a time. These twisted blade surfaces against the
		hub can be very slow (minutes per blade) or return an empty/invalid shape, so the result is checked
		and the compound is returned with a warning if the union did not come out sane.
		"""
		cad = cad or CadParams()
		hub = self.BuildHub(cad).val()
		blade = self.BuildBlade(cad)
		blades = [blade.rotate(cq.Vector(0, 0, 0), cq.Vector(0, 0, 1), 360.0 * k / self.Z_blade)
				  for k in range(self.Z_blade)]
		compound = cq.Workplane('XY').newObject([cq.Compound.makeCompound([hub] + blades)])
		if not fuse:
			return compound

		solid = hub
		for b in blades:
			solid = solid.fuse(b)
		solid = solid.clean()
		if len(solid.Solids()) == 1 and solid.isValid() and solid.Volume() > hub.Volume():
			return cq.Workplane('XY').newObject([solid])
		warnings.warn('Boolean union failed (empty or invalid result); returning hub and blades as separate solids')
		return compound

	def ExportSTEP(self, path: str, cad: CadParams = None, fuse: bool = False):
		wp = self.BuildImpeller(cad, fuse=fuse)
		shape = wp.val()
		if len(shape.Solids()) == 0 or shape.Volume() <= 0:
			raise RuntimeError('Impeller shape is empty, refusing to write an empty STEP file')
		cq.exporters.export(wp, path)

	def PlotBladeLines(self, cad: CadParams = None) -> go.Figure:
		"""Plan view of the blade camber lines (hub, mid, shroud) and the blade angle distributions."""
		from plotly.subplots import make_subplots
		cad = cad or CadParams()
		cad = CadParams(**{**cad.__dict__, 'n_span': 3})
		lines = self.GetBladeLines(cad)
		names = ['Hub', 'Mean', 'Shroud']
		colors = ['crimson', 'seagreen', 'royalblue']

		fig = make_subplots(rows=1, cols=2, subplot_titles=('Plan view', 'Blade angle'))
		for ln, name, c in zip(lines, names, colors):
			for k in range(self.Z_blade):
				th = ln['theta'] + 2*np.pi*k/self.Z_blade
				fig.add_trace(go.Scatter(
					x=ln['r']*np.cos(th), y=ln['r']*np.sin(th), mode='lines',
					line=dict(color=c), name=name, legendgroup=name, showlegend=(k == 0)), row=1, col=1)
			fig.add_trace(go.Scatter(
				x=ln['xi'], y=np.degrees(ln['beta']), mode='lines',
				line=dict(color=c), name=name, legendgroup=name, showlegend=False), row=1, col=2)

		r_2 = self.d_2.to('mm').magnitude / 2
		ang = np.linspace(0, 2*np.pi, 200)
		fig.add_trace(go.Scatter(x=r_2*np.cos(ang), y=r_2*np.sin(ang), mode='lines',
								 line=dict(color='grey', dash='dot'), name='Exit radius'), row=1, col=1)

		fig.update_xaxes(title_text='x (mm)', row=1, col=1)
		fig.update_yaxes(title_text='y (mm)', scaleanchor='x', scaleratio=1, row=1, col=1)
		fig.update_xaxes(title_text='Normalized meridional length m / m_total', row=1, col=2)
		fig.update_yaxes(title_text='Blade angle from tangent (deg)', row=1, col=2)
		fig.update_layout(template='plotly_white', title='Blade lines')
		fig.show()

		return fig